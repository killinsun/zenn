{
  "dependencies": {
    "zenn-cli": "^0.1.151"
  },
  "devDependencies": {
    "textlint": "^15.1.0",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "^1.0.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/* scripts/*.mjs",
    "textlint": "textlint articles/*.md",
    "textlint:fix": "textlint --fix articles/*.md",
    "validate": "node scripts/validate-articles.mjs",
    "validate:all": "node scripts/validate-articles.mjs --all",
    "natural": "uv run .agents/skills/natural-japanese/scripts/lint.py",
    "gate": "bash .githooks/pre-push"
  }
}
